# ------------------------------------------------------------------
# Backend environment variables — copy this file to `.env` and fill in
# NEVER commit the real .env file (it is git-ignored)
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173,http://localhost:4173

# MongoDB connection string (local mongod or MongoDB Atlas)
# If left empty in development, an in-memory MongoDB is started automatically.
MONGO_URI=mongodb+srv://ecommerce:ecommerce1@cluster0.dafhmrh.mongodb.net/


# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cloudinary (https://console.cloudinary.com -> Settings -> API Keys)
# OPTIONAL in development: leave these EMPTY and uploaded product images are
# stored locally (backend/uploads/, served at /api/uploads) so the full image
# flow works with no account. Fill in real keys to switch to Cloudinary
# (auto-detected). Placeholder values like "your_api_key" are IGNORED on purpose.
# In production these are REQUIRED.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay TEST mode keys (https://dashboard.razorpay.com -> API Keys)
# OPTIONAL in development: leave these blank/unset and checkout runs a local
# "demo gateway" that still performs real server-side HMAC signature verification.
# Set them to real test keys to switch to the actual Razorpay widget (auto-detected).
# In production these are REQUIRED — create-order returns 503 without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
